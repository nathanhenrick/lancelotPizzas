# Endereço da API (backendLancelotPizzas), terminando em /api/v1
NUXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Endereço da API visto pelo servidor do Nuxt (SSR), quando for diferente do de cima (ex.: no Docker)
NUXT_API_BASE_URL_SERVIDOR=
# Endereço público do site, usado no canonical e no og:url (ex.: https://suapizzaria.com.br)
NUXT_PUBLIC_SITE_URL=
# WhatsApp reserva, usado só se o painel não tiver um número salvo (DDI e DDD, só dígitos)
NUXT_PUBLIC_WHATSAPP=
